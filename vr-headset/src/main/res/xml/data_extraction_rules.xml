<?xml version="1.0" encoding="utf-8"?>
<!-- Identity, pairing credentials, media and transient scheduling state are never backed up or
     restored: a copied identity on another headset would create two devices with one credential. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
